round(
  prop.table(
    table(submersion$confidence_group)
  ) * 100,
  1
)


############          Confidence by Knowledge Score              ############

# Examine how many questions respondents answered correctly
# within each confidence group.
#
# This uses everyone with valid confidence and knowledge responses.

confidence_knowledge_data <- submersion %>%
  filter(
    !is.na(confidence_group),
    !is.na(knowledge_score)
  )

# Counts

confidence_knowledge_table <- table(
  confidence_knowledge_data$confidence_group,
  confidence_knowledge_data$knowledge_score
)

confidence_knowledge_table


# Row percentages

round(
  prop.table(
    confidence_knowledge_table,
    margin = 1
  ) * 100,
  1
)


############          Confidence and Knowledge Correlation          ###########

# Examine whether higher confidence tends to be associated
# with a higher number of correct answers.

cor.test(
  confidence_knowledge_data$confidence_score,
  confidence_knowledge_data$knowledge_score,
  method = "spearman",
  exact = FALSE
)


