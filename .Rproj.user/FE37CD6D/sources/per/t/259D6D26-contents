library(brglm2)


# ------------------------------------------------------------------------------
# WHY ARE WE DOING THIS?
# ------------------------------------------------------------------------------

# The ordinary multinomial model showed evidence of separation.
#
# Examples:
#
# - No "Other" gender respondents were Informed.
# - No Black respondents were Informed.
# - No Asian respondents were Informed.
# - No respondents in the "Other" race category were Informed.
#
# These zero cells can cause ordinary maximum-likelihood estimates from
# multinom() to become extremely large or small and make standard errors
# and p-values unreliable.
#
# brmultinom() uses bias-reduced estimation, which is designed to produce
# finite estimates even when separation occurs.


####################################################################################
############              BIAS-REDUCED MODEL 1                          ############
####################################################################################

br_model1 <- brmultinom(
  
  typology4 ~
    social_media_engagement +
    listened_radio_news +
    gender_model +
    race_model +
    educ_model,
  
  data = regression_data,
  
  ref = "Uninformed",
  
  type = "AS_mean"
)


summary(br_model1)


