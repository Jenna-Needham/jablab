# Do NOT automatically convert "not asked" into 0 unless the survey
# documentation tells us that "not asked" truly means no engagement.
#
# For now, keep structurally unasked respondents as NA.


data <- data %>%
  mutate(
    
    social_media_engagement = case_when(
      
      # Preserve survey skip / not asked as missing
      CC24_300d_1 == "not asked" ~ NA_real_,
      
      # Otherwise sum the five engagement behaviors
      TRUE ~
        posted_political_content +
        commented_politics +
        read_watched_political +
        followed_political_event +
        forwarded_political_content
    ),
    
    
    active_social_media = case_when(
      
      CC24_300d_1 == "not asked" ~ NA_real_,
      
      TRUE ~
        posted_political_content +
        commented_politics +
        forwarded_political_content
    ),
    
    
    passive_social_media = case_when(
      
      CC24_300d_1 == "not asked" ~ NA_real_,
      
      TRUE ~
        read_watched_political +
        followed_political_event
    )
  )


