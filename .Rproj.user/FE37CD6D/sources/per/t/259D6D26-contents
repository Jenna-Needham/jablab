####################################################################################
############             PHASE 2: CONFIDENCE VARIABLES                  ############
####################################################################################

data <- data %>%
  mutate(
    
    # Individual confidence categories
    not_confident = ifelse(CNJ201 == 1, 1, 0),
    somewhat_confident = ifelse(CNJ201 == 2, 1, 0),
    mid_confident = ifelse(CNJ201 == 3, 1, 0),
    very_confident = ifelse(CNJ201 == 4, 1, 0),
    complete_confident = ifelse(CNJ201 == 5, 1, 0),
    conf_dont_know = ifelse(CNJ201 == 998, 1, 0),
    
    
    # Three-category version
    confidence_group = case_when(
      CNJ201 %in% c(1, 2) ~ "Not confident at all",
      CNJ201 == 3 ~ "Unsure",
      CNJ201 %in% c(4, 5) ~ "Confident",
      TRUE ~ NA_character_
    ),
    
    
    # Binary version used for the 4-category typology
    #
    # 1, 2, 3 = Not confident
    # 4, 5    = Confident
    # 998 / missing = NA
    
    conf_binary = case_when(
      CNJ201 %in% c(4, 5) ~ "Confident",
      CNJ201 %in% c(1, 2, 3) ~ "Not confident",
      TRUE ~ NA_character_
    )
  )


# ------------------------------------------------------------------------------
# CHECK CONFIDENCE RECODING
# ------------------------------------------------------------------------------

table(data$CNJ201, data$confidence_group, useNA = "ifany")
table(data$CNJ201, data$conf_binary, useNA = "ifany")

table(data$confidence_group, useNA = "ifany")
table(data$conf_binary, useNA = "ifany")


####################################################################################
############          PHASE 3: KNOWLEDGE RESPONSE LABELS                ############
####################################################################################

data <- data %>%
  mutate(
    
    # CNJ202: Escape plan
    
    plan_escape = case_when(
      CNJ202 == 1 ~ "Window ASAP",
      CNJ202 == 2 ~ "Door ASAP",
      CNJ202 == 3 ~ "Window wait",
      CNJ202 == 4 ~ "Door wait",
      CNJ202 == 9 ~ "Don't know",
      TRUE ~ NA_character_
    ),
    
    
    # CNJ203: Time available
    
    time_escape = case_when(
      CNJ203 == 1 ~ "Less than 1 minute",
      CNJ203 == 2 ~ "1 minute",
      CNJ203 == 3 ~ "2-5 minutes",
      CNJ203 == 4 ~ "6-10 minutes",
      CNJ203 == 5 ~ "More than 10 minutes",
      CNJ203 == 9 ~ "Don't know",
      TRUE ~ NA_character_
    ),
    
    
    # CNJ204: Who should exit first
    
    who_save = case_when(
      CNJ204 == 1 ~ "Adult first",
      CNJ204 == 2 ~ "Child first",
      CNJ204 == 9 ~ "Don't know",
      TRUE ~ NA_character_
    )
  )


# ------------------------------------------------------------------------------
# CHECK RESPONSE LABELS
# ------------------------------------------------------------------------------

table(data$CNJ202, data$plan_escape, useNA = "ifany")
table(data$CNJ203, data$time_escape, useNA = "ifany")
table(data$CNJ204, data$who_save, useNA = "ifany")


####################################################################################
############              PHASE 4: CORRECT ANSWERS                      ############
####################################################################################

# IMPORTANT:
#
# Confirm these against the actual questionnaire / codebook BEFORE final analysis.
#
# Current assumed answer key:
#
# CNJ202:
#   1 = Window ASAP = CORRECT
#
# CNJ203:
#   1 = Less than 1 minute = CORRECT
#   2 = 1 minute           = CORRECT
#
# CNJ204:
#   2 = Child first = CORRECT
#
# If the questionnaire/codebook says otherwise, change the answer key here
# BEFORE continuing.


data <- data %>%
  mutate(
    
    correct_CNJ202 = case_when(
      CNJ202 == 1 ~ 1,
      is.na(CNJ202) ~ NA_real_,
      TRUE ~ 0
    ),
    
    
    correct_CNJ203 = case_when(
      CNJ203 %in% c(1, 2) ~ 1,
      is.na(CNJ203) ~ NA_real_,
      TRUE ~ 0
    ),
    
    
    # ASSUMING CNJ204 = 2 means "Child first"
    
    correct_CNJ204 = case_when(
      CNJ204 == 2 ~ 1,
      is.na(CNJ204) ~ NA_real_,
      TRUE ~ 0
    )
  )


# ------------------------------------------------------------------------------
# VERY IMPORTANT CHECKS
# ------------------------------------------------------------------------------

# Each original response should map to the intended correct/incorrect value.

table(data$CNJ202, data$correct_CNJ202, useNA = "ifany")

table(data$CNJ203, data$correct_CNJ203, useNA = "ifany")

table(data$CNJ204, data$correct_CNJ204, useNA = "ifany")


# Check totals correct on each item

table(data$correct_CNJ202, useNA = "ifany")
table(data$correct_CNJ203, useNA = "ifany")
table(data$correct_CNJ204, useNA = "ifany")


####################################################################################
############                PHASE 5: ALL CORRECT                        ############
####################################################################################

data <- data %>%
  mutate(
    
    all_correct = case_when(
      
      # If any of the three survey questions is genuinely missing,
      # all_correct should also be missing.
      
      is.na(correct_CNJ202) |
        is.na(correct_CNJ203) |
        is.na(correct_CNJ204) ~ NA_real_,
      
      
      # Must answer ALL THREE correctly
      
      correct_CNJ202 == 1 &
        correct_CNJ203 == 1 &
        correct_CNJ204 == 1 ~ 1,
      
      
      # Otherwise respondent missed at least one
      
      TRUE ~ 0
    )
  )


# ------------------------------------------------------------------------------
# CHECK ALL_CORRECT
# ------------------------------------------------------------------------------

table(data$all_correct, useNA = "ifany")

prop.table(
  table(data$all_correct)
)


# See the combinations of correct/incorrect answers

table(
  data$correct_CNJ202,
  data$correct_CNJ203,
  data$correct_CNJ204,
  useNA = "ifany"
)


# CRITICAL CHECK:
# Anyone coded all_correct == 1 should ONLY have:
#
# CNJ202 = 1
# CNJ203 = 1 or 2
# CNJ204 = 2

data %>%
  filter(all_correct == 1) %>%
  count(CNJ202, CNJ203, CNJ204)


####################################################################################
############       PHASE 6: CONFIDENCE-COMPETENCE TYPOLOGY             ############
####################################################################################

# Build the four-category measure DIRECTLY from conf_binary.
#
# This avoids using one definition of confidence in one place
# and another definition somewhere else.


data <- data %>%
  mutate(
    
    conf_know_4 = case_when(
      
      conf_binary == "Confident" &
        all_correct == 1 ~ "Confident and correct",
      
      conf_binary == "Confident" &
        all_correct == 0 ~ "Confident but incorrect",
      
      conf_binary == "Not confident" &
        all_correct == 1 ~ "Not confident but correct",
      
      conf_binary == "Not confident" &
        all_correct == 0 ~ "Not confident and incorrect",
      
      TRUE ~ NA_character_
    )
  )


# ------------------------------------------------------------------------------
# CHECK FOUR-CATEGORY TYPOLOGY
# ------------------------------------------------------------------------------

table(data$conf_know_4, useNA = "ifany")

prop.table(
  table(data$conf_know_4)
)


# Cross-check confidence and correctness manually

table(
  data$conf_binary,
  data$all_correct,
  useNA = "ifany"
)


# The resulting table should correspond exactly to:
#
# Confident + 1     = Confident and correct
# Confident + 0     = Confident but incorrect
# Not confident + 1 = Not confident but correct
# Not confident + 0 = Not confident and incorrect


table(
  data$conf_binary,
  data$conf_know_4,
  useNA = "ifany"
)


####################################################################################
############       PHASE 7: REGRESSION OUTCOME VARIABLE                 ############
####################################################################################

data <- data %>%
  mutate(
    
    typology4 = case_when(
      
      conf_know_4 == "Confident and correct" ~
        "Informed",
      
      conf_know_4 == "Confident but incorrect" ~
        "Misinformed",
      
      conf_know_4 == "Not confident but correct" ~
        "Underinformed",
      
      conf_know_4 == "Not confident and incorrect" ~
        "Uninformed",
      
      TRUE ~ NA_character_
    )
  )


# Set UNINFORMED as the reference category.

data$typology4 <- factor(
  data$typology4,
  levels = c(
    "Uninformed",
    "Informed",
    "Misinformed",
    "Underinformed"
  )
)


