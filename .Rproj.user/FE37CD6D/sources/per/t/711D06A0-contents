model2_se <- model2_summary$standard.errors


model2_coef

model2_se

################################################################################
############              MODEL 1 P-VALUES                            ############
################################################################################

# Calculate z-scores.

model1_z <- model1_coef / model1_se


# Calculate two-sided p-values.

model1_p <- 2 * (1 - pnorm(abs(model1_z)))


model1_z

model1_p

################################################################################
############              MODEL 2 P-VALUES                            ############
################################################################################

model2_z <- model2_coef / model2_se


model2_p <- 2 * (1 - pnorm(abs(model2_z)))


model2_z

model2_p

