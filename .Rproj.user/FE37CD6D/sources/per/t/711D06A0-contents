model1_RRR <- exp(model1_coef)

model1_RRR


############              Model 2                                    ############

model2_RRR <- exp(model2_coef)

model2_RRR

################################################################################
############           95% CONFIDENCE INTERVALS                      ############
################################################################################

############              Model 1                                    ############

model1_lower <- exp(
  model1_coef - 1.96 * model1_se
)

model1_upper <- exp(
  model1_coef + 1.96 * model1_se
)


model1_lower

model1_upper


############              Model 2                                    ############

model2_lower <- exp(
  model2_coef - 1.96 * model2_se
)

model2_upper <- exp(
