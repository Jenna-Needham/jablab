################################################################################
############            PREPARE VARIABLES FOR REGRESSION                ############
################################################################################

# Set factor levels and reference categories.
#
# Outcome reference:
#   Uninformed
#
# Predictor references:
#   Gender = Man
#   Race = White
#   Education = High school or less
#   Party ID = Independent

submersion <- submersion %>%
  mutate(
    
    information_status = factor(
      information_status,
      levels = c(
        "Uninformed",
        "Informed",
        "Misinformed",
        "Underinformed"
      )
    ),
    
    gender = factor(
      gender,
      levels = c(
        "Man",
        "Woman"
      )
    ),
    
    race_group = factor(
      race_group,
      levels = c(
        "White",
        "Black",
        "Hispanic",
        "Asian",
        "Other"
      )
    ),
    
    education = factor(
      education,
      levels = c(
        "High school or less",
        "Some college / 2-year degree",
        "College degree or higher"
      )
    ),
    
    pid3_model = factor(
      pid3_model,
      levels = c(
        "Independent",
        "Democrat",
        "Republican"
      )
    )
  )

################################################################################
############                    CHECK FACTORS                           ############
