# Combine Informed and Underinformed into one category.
# Everyone in the new "All correct" category answered
# all three knowledge questions correctly, regardless of confidence.

submersion <- submersion %>%
  mutate(
    information_status_3cat = case_when(
      as.character(information_status) %in%
        c("Informed", "Underinformed") ~ "All correct",
      
      as.character(information_status) == "Misinformed" ~ "Misinformed",
      
      as.character(information_status) == "Uninformed" ~ "Uninformed",
      
      TRUE ~ NA_character_
    ),
    
    information_status_3cat = factor(
      information_status_3cat,
      levels = c(
        "Uninformed",
        "Misinformed",
        "All correct"
      )
    )
  )

