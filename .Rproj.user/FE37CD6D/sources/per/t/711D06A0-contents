################################################################################
############           MODEL 1 COEFFICIENTS AND SE                    ############
################################################################################

model1_summary <- summary(model1)

model1_coef <- model1_summary$coefficients

model1_se <- model1_summary$standard.errors


model1_coef

model1_se

################################################################################
############           MODEL 2 COEFFICIENTS AND SE                    ############
################################################################################

model2_summary <- summary(model2)

