############                  Family Income                     ############

# STEP 1: Examine variable and coding schema

table(submersion$faminc_new, useNA = "ifany")

# STEP 2: Create income variables 

submersion <- submersion %>%
  mutate(
    income_group = case_when(
      
      faminc_new %in% c(
        "Less than $10,000",
        "$10,000 - $19,999",
        "$20,000 - $29,999",
        "$30,000 - $39,999"
      ) ~ "Under $40,000",
      
      faminc_new %in% c(
        "$40,000 - $49,999",
        "$50,000 - $59,999",
        "$60,000 - $69,999",
        "$70,000 - $79,999"
      ) ~ "$40,000 to $79,999",
      
      faminc_new %in% c(
        "$80,000 - $99,999",
        "$100,000 - $119,999",
        "$120,000 - $149,999"
      ) ~ "$80,000 to $149,999",
      
      faminc_new %in% c(
        "$150,000 - $199,999",
        "$200,000 - $249,999",
        "$250,000 - $349,999",
        "$350,000 - $499,999",
        "$500,000 or more"
      ) ~ "$150,000 or more",
      
      faminc_new == "Prefer not to say" ~ NA_character_,
      
      TRUE ~ NA_character_
    )
  )

# STEP 3: Confirm creation

table(submersion$income_group, useNA = "ifany")
table(submersion$faminc_new, submersion$income_group, useNA = "ifany")

