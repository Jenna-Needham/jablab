################################################################################
############          CALCULATE RRRs AND P-VALUES                     ############
################################################################################
############              INCOME MODEL                               ############
income_coef <- summary(income_model)$coefficients
income_se <- summary(income_model)$standard.errors
income_RRR <- exp(income_coef)
income_p <- 2 * (1 - pnorm(abs(income_coef / income_se)))
############              HOMEOWNERSHIP MODEL                         ############
home_coef <- summary(homeownership_model)$coefficients
home_se <- summary(homeownership_model)$standard.errors
home_RRR <- exp(home_coef)
home_p <- 2 * (1 - pnorm(abs(home_coef / home_se)))
############              REGION MODEL                               ############
region_coef <- summary(region_model)$coefficients
region_se <- summary(region_model)$standard.errors
region_RRR <- exp(region_coef)
region_p <- 2 * (1 - pnorm(abs(region_coef / region_se)))
############              EMPLOYMENT MODEL                           ############
employment_coef <- summary(employment_model)$coefficients
employment_se <- summary(employment_model)$standard.errors
employment_RRR <- exp(employment_coef)
employment_p <- 2 * (1 - pnorm(abs(employment_coef / employment_se)))
################################################################################
############          COMPARE MAIN PREDICTORS                         ############
################################################################################
main_results <- data.frame(
Added_variable = c(
"Income", "Income",
"Homeownership", "Homeownership",
"Region", "Region",
"Employment", "Employment"
),
Comparison = c(
"Social media: Informed vs Uninformed",
"Radio: Misinformed vs Uninformed",
"Social media: Informed vs Uninformed",
"Radio: Misinformed vs Uninformed",
"Social media: Informed vs Uninformed",
"Radio: Misinformed vs Uninformed",
"Social media: Informed vs Uninformed",
"Radio: Misinformed vs Uninformed"
),
RRR = c(
income_RRR["Informed", "social_media_engagement"],
income_RRR["Misinformed", "listened_radio_news"],
home_RRR["Informed", "social_media_engagement"],
home_RRR["Misinformed", "listened_radio_news"],
region_RRR["Informed", "social_media_engagement"],
region_RRR["Misinformed", "listened_radio_news"],
employment_RRR["Informed", "social_media_engagement"],
employment_RRR["Misinformed", "listened_radio_news"]
),
p_value = c(
income_p["Informed", "social_media_engagement"],
income_p["Misinformed", "listened_radio_news"],
home_p["Informed", "social_media_engagement"],
home_p["Misinformed", "listened_radio_news"],
region_p["Informed", "social_media_engagement"],
region_p["Misinformed", "listened_radio_news"],
employment_p["Informed", "social_media_engagement"],
employment_p["Misinformed", "listened_radio_news"]
)
)
main_results$RRR <- round(main_results$RRR, 3)
main_results$p_value <- round(main_results$p_value, 4)
main_results
