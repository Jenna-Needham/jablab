model1_p[, c(
"social_media_engagement",
"listened_radio_news"
)]
model2_RRR[, c(
"social_media_engagement",
"listened_radio_news"
)]
model2_p[, c(
"social_media_engagement",
"listened_radio_news"
)]
model2_RRR[, c(
"pid3_modelDemocrat",
"pid3_modelRepublican"
)]
model2_p[, c(
"pid3_modelDemocrat",
"pid3_modelRepublican"
)]
AIC(model1)
AIC(model2)
table(
regression_data$listened_radio_news,
regression_data$information_status
)
round(
prop.table(
table(
regression_data$listened_radio_news,
regression_data$information_status
),
margin = 1
) * 100,
1
)
regression_data %>%
group_by(information_status) %>%
summarise(
n = n(),
mean_social_media = mean(social_media_engagement),
sd_social_media = sd(social_media_engagement)
)
################################################################################
############       CREATE COLLAPSED INFORMATION STATUS                ############
################################################################################
# Combine Informed and Underinformed into one category.
# Everyone in the new "All correct" category answered
# all three knowledge questions correctly, regardless of confidence.
submersion <- submersion %>%
mutate(
information_status_3cat = case_when(
as.character(information_status) %in%
c("Informed", "Underinformed") ~ "All correct",
as.character(information_status) == "Misinformed" ~ "Misinformed",
as.character(information_status) == "Uninformed" ~ "Uninformed",
TRUE ~ NA_character_
),
information_status_3cat = factor(
information_status_3cat,
levels = c(
"Uninformed",
"Misinformed",
"All correct"
)
)
)
############              Check Number of Respondents in each Category
table(
submersion$information_status_3cat,
useNA = "ifany"
)
round(
prop.table(
table(submersion$information_status_3cat)
) * 100,
1
)
############              Check Regression Sample
regression_data_3cat <- submersion %>%
select(
information_status_3cat,
social_media_engagement,
listened_radio_news,
gender,
race_group,
education,
pid3_model
) %>%
na.omit()
nrow(regression_data_3cat)
table(regression_data_3cat$information_status_3cat)
round(
prop.table(
table(regression_data_3cat$information_status_3cat)
) * 100,
1
)
################################################################################
############          COLLAPSED MODEL 1                              ############
################################################################################
model1_3cat <- multinom(
information_status_3cat ~
social_media_engagement +
listened_radio_news +
gender +
race_group +
education,
data = regression_data_3cat,
Hess = TRUE,
trace = FALSE
)
summary(model1_3cat)
################################################################################
############          COLLAPSED MODEL 2                              ############
################################################################################
model2_3cat <- multinom(
information_status_3cat ~
social_media_engagement +
listened_radio_news +
gender +
race_group +
education +
pid3_model,
data = regression_data_3cat,
Hess = TRUE,
trace = FALSE
)
summary(model2_3cat)
################################################################################
############          COLLAPSED MODEL 2 RESULTS                      ############
################################################################################
model2_3cat_summary <- summary(model2_3cat)
model2_3cat_coef <- model2_3cat_summary$coefficients
model2_3cat_se <- model2_3cat_summary$standard.errors
# Relative risk ratios
model2_3cat_RRR <- exp(model2_3cat_coef)
# Calculate p-values
model2_3cat_z <- model2_3cat_coef / model2_3cat_se
model2_3cat_p <- 2 * (1 - pnorm(abs(model2_3cat_z)))
################################################################################
############          SOCIAL MEDIA AND RADIO                          ############
################################################################################
# Compare All correct with Uninformed.
model2_3cat_RRR[
"All correct",
c(
"social_media_engagement",
"listened_radio_news"
)
]
model2_3cat_p[
"All correct",
c(
"social_media_engagement",
"listened_radio_news"
)
]
# Compare Misinformed with Uninformed.
model2_3cat_RRR[
"Misinformed",
c(
"social_media_engagement",
"listened_radio_news"
)
]
model2_3cat_p[
"Misinformed",
c(
"social_media_engagement",
"listened_radio_news"
)
]
################################################################################
############          PARTY IDENTIFICATION                            ############
################################################################################
# Independents remain the reference party category.
model2_3cat_RRR[
,
c(
"pid3_modelDemocrat",
"pid3_modelRepublican"
)
]
model2_3cat_p[
,
c(
"pid3_modelDemocrat",
"pid3_modelRepublican"
)
]
################################################################################
############          COLLAPSED MODEL FIT                             ############
################################################################################
AIC(model1_3cat)
AIC(model2_3cat)
# How many respondents are in each collapsed category?
table(regression_data_3cat$information_status_3cat)
round(
prop.table(
table(regression_data_3cat$information_status_3cat)
) * 100,
1
)
# Social media and radio: RRRs and p-values
model2_3cat_RRR[
,
c("social_media_engagement", "listened_radio_news")
]
model2_3cat_p[
,
c("social_media_engagement", "listened_radio_news")
]
# Party identification: Independents are the reference group
model2_3cat_RRR[
,
c("pid3_modelDemocrat", "pid3_modelRepublican")
]
model2_3cat_p[
,
c("pid3_modelDemocrat", "pid3_modelRepublican")
]
################################################################################
############          NEW SES VARIABLES                                  ############
################################################################################
submersion <- submersion %>%
mutate(
income_group = factor(
income_group,
levels = c(
"Under $40,000",
"$40,000 to $79,999",
"$80,000 to $149,999",
"$150,000 or more"
)
),
home_ownership = factor(
home_ownership,
levels = c(
"Own",
"Rent",
"Other"
)
),
region_group = factor(
region_group,
levels = c(
"Northeast",
"Midwest",
"South",
"West"
)
),
employment_group = factor(
employment_group,
levels = c(
"Employed",
"Unemployed",
"Not in labor force"
)
)
)
################################################################################
############          CHECK REFERENCE CATEGORIES                       ############
################################################################################
levels(submersion$income_group)
levels(submersion$home_ownership)
levels(submersion$region_group)
levels(submersion$employment_group)
############              Income Model
income_data <- submersion %>%
select(
information_status,
social_media_engagement,
listened_radio_news,
gender,
race_group,
education,
pid3_model,
income_group
) %>%
na.omit()
# Sample size
nrow(income_data)
# Baseline model using the income-complete sample
income_base_model <- multinom(
information_status ~
social_media_engagement +
listened_radio_news +
gender +
race_group +
education +
pid3_model,
data = income_data,
Hess = TRUE,
trace = FALSE
)
# Model adding family income
income_model <- multinom(
information_status ~
social_media_engagement +
listened_radio_news +
gender +
race_group +
education +
pid3_model +
income_group,
data = income_data,
Hess = TRUE,
trace = FALSE
)
# Results
summary(income_model)
# Compare model fit on the same respondents
AIC(income_base_model)
AIC(income_model)
############              Homeownership Model
